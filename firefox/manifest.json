{
  "name": "GOG-to-GOG-games",
  "description": "Add an “Install” button to the GOG website that allows users to directly install game files from the site.",
  "version": "1.0.0",
  "manifest_version": 2,
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "https://gog-games.to/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "js": ["main.js"],
      "matches": [
        "https://www.gog.com/*/game/*"
      ]
    }
  ]
}